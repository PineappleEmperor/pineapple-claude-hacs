__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Shell/editor dotfiles that land in the workspace root. The project's own dotted
# paths are re-included, so a new one has to be named here to be tracked.
/.*
!/.github/
!/.githooks/
!/.claude-plugin/
!/.gitignore
# The project hook layer describes conventions specific to this repo, so it travels
# with it. Everything else under .claude/ is per-machine state, including the
# settings.local.json personal layer.
!/.claude/
/.claude/*
!/.claude/settings.json
